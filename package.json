{
  "name": "interact",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev --include 'packages/*' run build && yarn workspaces foreach --all --include 'apps/*' run build",
    "lint": "eslint . --max-warnings=0",
    "test": "yarn workspaces foreach --all --include 'packages/*' run test",
    "dev:website": "yarn workspace @wix/interact-website run dev",
    "dev:docs": "yarn workspace @wix/interact-docs run dev",
    "dev:demo": "yarn workspace @wix/interact-demo run dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "serve": "npx http-server apps/website -l 3000",
    "serve:public": "npx http-server apps/website -l tcp://0.0.0.0:3000",
    "generate:llms": "node scripts/generate-llms.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wix/interact.git"
  },
  "description": "Monorepo for the Interact animation and interaction libraries - web-native, AI-ready, framework-agnostic.",
  "keywords": [
    "animation",
    "waapi",
    "web-animations-api",
    "javascript",
    "css",
    "scroll-driven",
    "motion",
    "interaction",
    "web-components",
    "wix"
  ],
  "author": {
    "name": "wow!Team",
    "email": "wow-dev@wix.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wix/interact/issues"
  },
  "homepage": "https://github.com/wix/interact#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "3.8.3",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "semver": "7.8.0"
  }
}
